# =============================================================================
# SkillPay AI — Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to:
#   - server/.env (Backend)
#   - client/.env (Frontend)
# Fill in your own credentials from PayPal Developer and Google AI Studio.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Server Configuration (server/.env)
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Firebase Firestore & Auth
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
FIREBASE_EMULATOR=false

# PayPal Smart Escrow (Orders v2 API)
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-secret
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYOUT_MODE=simulated
PLATFORM_FEE_PERCENT=5

# Google Gemini AI Layer
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# 2. Client Configuration (client/.env)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1
VITE_USE_MOCK=false
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id

